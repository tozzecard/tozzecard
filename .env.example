# Binance Web3 API — https://web3.binance.com/en/dev-portal
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# BSC mainnet (chain 56)
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Revenue: Trading API feePercent recipient
# Revenue model depends on live check L4 (docs/plan.md §4)
TREASURY_ADDRESS=
FEE_PERCENT=0.3

# apps/api
API_PORT=8787
DATABASE_URL=

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:8787

# SQLite file for close references (apps/api)
DB_PATH=tozzecard.sqlite
MARKET_POLL_MS=60000

# Demo merchant (B402). Must equal the write-once payTo set in the dev portal B402 application.
MERCHANT_PAY_TO=
