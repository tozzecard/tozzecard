# Binance Web3 API — https://web3.binance.com/en/dev-portal
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# BSC mainnet (chain 56)
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# apps/api
API_PORT=8787
# Browser origins allowed to call the API (comma-separated)
WEB_ORIGIN=http://localhost:3000,https://tozzecard.xyz,https://app.tozzecard.xyz

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:8787

# SQLite file for close references (apps/api)
DB_PATH=tozzecard.sqlite
MARKET_POLL_MS=60000

# Cards (apps/api). Derives card numbers/CVVs and hashes identity documents (openssl rand -hex 32).
# Changing it changes every card number.
CARD_SECRET=
# Identity check with Didit (https://business.didit.me): API key, KYC workflow id, webhook secret.
# Webhook URL in the Didit console: https://api.tozzecard.xyz/kyc/didit
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# Demo merchant (B402). Must equal the write-once payTo set in the dev portal B402 application.
MERCHANT_PAY_TO=

# Refill scheduler (apps/api). off (default) | dry (log decisions only) | live (trades real money)
AGENT_MODE=off
CARD_ADDRESS=
# The card the agent refills (also the only address in the Agentic Wallet address book).
# Default strategy until the card saves one with PUT /strategy.
# token address -> target weight, e.g. {"0xa9ee...":0.5,"0x02fc...":0.5}
AGENT_TARGETS={}
WEEKLY_ESTIMATE_USD=70
TZ_OFFSET_MIN=420
CARD_CREATED_AT=

# packages/agent (baw). Server only: stable key for the baw session file (openssl rand -hex 32).
# Without it baw derives the key from the MAC address and a redeploy loses the session.
BINANCE_INSTANCE_ID=
